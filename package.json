{
  "name": "murmur",
  "private": true,
  "version": "1.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "bun scripts/check.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "icons:generate": "cargo run --locked --manifest-path src-tauri/Cargo.toml --example generate_macos_icons",
    "icons:check": "cargo run --locked --manifest-path src-tauri/Cargo.toml --example generate_macos_icons -- --check",
    "test:updater-manifest": "node .github/scripts/publish-updater-manifest.test.mjs && node .github/scripts/updater-targets.test.mjs && node .github/scripts/updater-signature.test.mjs && node .github/scripts/publish-updater-pipeline.test.mjs && node .github/scripts/release-dry-run.test.mjs",
    "test:release-contract": "bun scripts/release-contract.test.ts",
    "test:windows-updater": "node .github/scripts/windows-updater-manifest.test.mjs",
    "test:changed-paths": "node .github/scripts/changed-paths.test.mjs",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "bun scripts/check-translations.ts",
    "check:platforms": "bun scripts/check-platforms.ts",
    "check:macos-only": "bun run check:platforms",
    "test:platforms": "bun test scripts/check-platforms.test.ts",
    "check:types": "tsc -p tsconfig.tests.json --noEmit",
    "check:versions": "bun scripts/check-versions.ts",
    "check:file-size": "bun scripts/check-file-size.ts",
    "check:playwright-paths": "bun scripts/check-playwright-paths.ts",
    "check:doctests": "bun scripts/check-doctests.ts",
    "test:file-size": "bun test scripts/check-file-size.test.ts",
    "test:playwright-paths": "bun scripts/check-playwright-paths.test.ts",
    "test:doctests": "bun scripts/check-doctests.test.ts",
    "test:versions": "bun scripts/check-versions.test.ts",
    "test:macos-expanded": "bun scripts/macos-expanded.test.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "html-to-image": "^1.11.13",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "flatted": "3.4.4",
    "minimatch": "11.0.1",
    "nanoid": "3.3.18",
    "picomatch": "4.0.7",
    "postcss": "8.5.26"
  }
}
