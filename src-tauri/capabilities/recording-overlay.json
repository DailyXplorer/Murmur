{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "recording-overlay",
  "description": "Least-privilege capabilities for the recording overlay",
  "windows": ["recording_overlay"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "os:allow-locale",
    "allow-get-app-settings",
    "allow-cancel-operation",
    "allow-copy-notice-again",
    "allow-copy-meeting-notice",
    "allow-open-meeting-notice",
    "allow-dismiss-meeting-notice",
    "allow-fit-copy-notice",
    "allow-restore-cancelled-dictation"
  ]
}
