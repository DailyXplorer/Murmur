{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur",
  "version": "1.0.9",
  "identifier": "com.dailyxplorer.murmur",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/recordings/*.wav"],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "resources": ["resources/**/*"],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRDM2QUM1NjE3RDIyRkUKUldUK0luMWh4V3JUTWRMTTA3RlREbVBESGs4WDlSYXA0Nk5FekcrdHhoWElPeXAzaVhncHc2N1oK",
      "endpoints": [
        "https://github.com/DailyXplorer/Murmur/releases/latest/download/latest.json"
      ]
    }
  }
}
